  "thresholds": {
    "spam": 6,
    "unsure": 3,
    "short_message_chars": 25,
    "amount_regex": "\\d[\\d,.]{3,}\\s*(ریال|تومان|IRR|IRT)?|\\d{1,3}(,\\d{3})+"
  },
  "senders": {
    "allow_exact": [],
    "allow_contains": [
      "بانک",
      "Bank",
      "بیمه",
      "پست",
      "ایرانسل",
      "همراه اول",
      "رایتل",
      "دیجی‌کالا",
      "اسنپ"
    ],
    "block_exact": []
  },
  "model": {
    "spam_p": 0.5,
    "unsure_p": 0.3,
    "soft_guard_conf": 0.9,
    "_comment": "Measured on 10,031 real Persian messages: soft guard (telecom/service/bank/public) only protects when model p<0.9, otherwise it was leaking 27pp of ads. Hard guard (otp/gov/transaction-with-amount) always protects. Result: spam recall 0.88, important kept 0.983."
  },
  "guard_hard": [
    "otp",
    "gov",
    "transaction",
    "transaction_confirm"
  ]
}
